#!/usr/bin/env bash
# Ping Panel helper. Runs from anywhere on any machine.
set -euo pipefail

# Resolve the repo from this script's own location rather than a hardcoded
# path. `readlink -f` follows the ~/.local/bin symlink install.sh creates, so
# the repo can be cloned anywhere and moved afterwards without breaking this.
SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
REPO="${DPINGS_REPO:-$(dirname -- "$(dirname -- "$SELF")")}"

[[ -f "$REPO/package/metadata.json" ]] || {
  echo "dpings: $REPO does not look like the plasma-ping-panel repo" >&2
  echo "        (set DPINGS_REPO if you moved it)" >&2
  exit 1
}
# shellcheck source=common.sh
source "$REPO/bin/common.sh"

usage() {
  cat <<EOF
usage: dpings <command>

  status    show bridge state: up/down, ping count, last update
  doctor    check every part of the install and say what is broken
  clear     empty the ping list (do this before enabling PingBridge for real)
  mock      write fake pings so the widget can be tested with Discord closed
  watch     write fake pings, then print every command the widget sends
  sync      copy the bridge plugin from the repo into BetterDiscord's folder
  inject    (re)inject BetterDiscord into Discord's core module
  uninject  undo that, restoring Discord's original index.js
  test      run the model + bridge test suites
  sort      print the current ordering produced by scorePing()
  reload    restart plasmashell to pick up QML changes
  edit      open PingModel.js (where scorePing lives) in \$EDITOR
  package   build the store archive (.tar.gz)
EOF
}

case "${1:-}" in
  clear)  node "$REPO/tools/mock-bridge.mjs" --clear ;;
  mock)   node "$REPO/tools/mock-bridge.mjs" --once ;;
  watch)  node "$REPO/tools/mock-bridge.mjs" ;;
  test)   node "$REPO/tests/model-test.mjs" && node "$REPO/tests/bridge-test.mjs" ;;
  sort)   node "$REPO/tests/model-test.mjs" | sed -n '/current ordering/,$p' ;;
  package) "$REPO/tools/package.sh" ;;
  edit)   "${EDITOR:-nano}" "$REPO/package/contents/ui/PingModel.js" ;;
  reload)
    kquitapp6 plasmashell >/dev/null 2>&1 || true
    sleep 2
    (setsid plasmashell >/dev/null 2>&1 &)
    echo "plasmashell restarted"
    ;;

  sync)
    # A real copy, not a symlink — BD's addon scanner is unreliable with links.
    n=0
    while read -r bd; do
      install -m 0644 "$REPO/$BRIDGE_SRC_REL" "$bd/PingBridge.plugin.js"
      echo "synced -> $bd/PingBridge.plugin.js"
      n=$((n + 1))
    done < <(bd_plugin_dirs)
    (( n )) || die "no BetterDiscord plugins folder found — is BetterDiscord installed?"
    echo "BetterDiscord hot-reloads plugins; no Discord restart needed"
    ;;

  inject|uninject)
    # Discord overwrites index.js on every update, undoing the injection.
    asar="$CONFIG_HOME/BetterDiscord/data/betterdiscord.asar"
    mapfile -t cores < <(discord_core_dirs)
    (( ${#cores[@]} )) || die "no discord_desktop_core found — is Discord installed?"
    core="${cores[-1]}"                      # newest app version wins
    idx="$core/index.js"
    if [[ "$1" == "uninject" ]]; then
      if [[ -f "$idx.orig" ]]; then
        mv -f "$idx.orig" "$idx"; echo "restored $idx"
      else
        printf "%s\n" "module.exports = require('./core.asar');" > "$idx"
        echo "no backup found; wrote Discord's default line to $idx"
      fi
    else
      [[ -f "$asar" ]] || die "$asar missing — install BetterDiscord first"
      if grep -q betterdiscord "$idx" 2>/dev/null; then
        echo "already injected: $idx"
      else
        cp -n "$idx" "$idx.orig" 2>/dev/null || true
        printf '%s\n%s\n' "require(\"$asar\");" "module.exports = require('./core.asar');" > "$idx"
        echo "injected $idx"
      fi
    fi
    echo "restart Discord completely (tray icon -> Quit) for this to take effect"
    ;;

  status)
    f="$BRIDGE_DIR/pings.json"
    [[ -f "$f" ]] || { echo "no state file at $f (bridge has never run)"; exit 0; }
    node -e '
      const fs = require("fs");
      const s = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      const n = (s.pings || []).length;
      const unread = (s.pings || []).filter(p => !p.read).length;
      const age = Math.round((Date.now() - (s.updatedAt || 0)) / 1000);
      console.log(`bridge:  ${s.bridgeUp ? "up" : "DOWN"}${s.error ? " — " + s.error : ""}`);
      console.log(`pings:   ${n} (${unread} unread)`);
      console.log(`updated: ${age}s ago`);
      if (s.degraded && s.degraded.length) console.log(`degraded: missing ${s.degraded.join(", ")}`);
      const byKind = {};
      for (const p of s.pings || []) byKind[p.kind] = (byKind[p.kind] || 0) + 1;
      if (n) console.log("kinds:   " + Object.entries(byKind).map(([k, v]) => `${k}=${v}`).join(" "));
    ' "$f"
    ;;

  doctor)
    # Walks the chain in dependency order, so the first FAIL is the real cause.
    rc=0
    ok()   { printf '  \033[1;32mok\033[0m   %s\n' "$*"; }
    bad()  { printf '  \033[1;31mFAIL\033[0m %s\n' "$*"; rc=1; }
    note() { printf '       %s\n' "$*"; }

    echo "repo"
    ok "$REPO"

    echo "plasma applet"
    if [[ -e "$PLASMOID_DIR" ]]; then
      ok "installed at $PLASMOID_DIR$([[ -L "$PLASMOID_DIR" ]] && echo ' (dev symlink)')"
    else
      bad "not installed"; note "run ./install.sh"
    fi
    for legacy in "${LEGACY_APPLET_IDS[@]}"; do
      # -L too: a dangling dev symlink is invisible to -e alone.
      [[ -e "$DATA_HOME/plasma/plasmoids/$legacy" || -L "$DATA_HOME/plasma/plasmoids/$legacy" ]] || continue
      bad "stale copy under the old ID $legacy"
      note "run ./install.sh to migrate, then re-add the widget to your panel"
    done

    echo "betterdiscord"
    if bd_plugin_dirs >/dev/null; then
      while read -r bd; do
        if [[ -f "$bd/PingBridge.plugin.js" ]]; then ok "bridge present in $bd"
        else bad "bridge missing from $bd"; note "run dpings sync"; fi
      done < <(bd_plugin_dirs)
    else
      bad "no BetterDiscord plugins folder"
      note "install BetterDiscord: https://betterdiscord.app"
    fi

    echo "discord injection"
    mapfile -t cores < <(discord_core_dirs)
    if (( ${#cores[@]} )); then
      if grep -q betterdiscord "${cores[-1]}/index.js" 2>/dev/null; then
        ok "injected into ${cores[-1]}"
      else
        bad "not injected (Discord updates undo this)"; note "run dpings inject, then fully quit and relaunch Discord"
      fi
    else
      bad "no discord_desktop_core found"; note "is the Discord desktop app installed?"
    fi

    echo "bridge state"
    if [[ -f "$BRIDGE_DIR/pings.json" ]]; then
      ok "$BRIDGE_DIR/pings.json"
      "$SELF" status | sed 's/^/       /'
    else
      bad "no state file yet"; note "enable PingBridge in Discord: Settings -> BetterDiscord -> Plugins"
    fi

    echo "url handler"
    if [[ "$(xdg-mime query default x-scheme-handler/discord 2>/dev/null)" == *discord* ]]; then
      ok "discord:// opens the Discord app"
    else
      bad "discord:// is not registered"; note "Enter will fall back to the browser"
    fi

    exit $rc
    ;;

  ""|-h|--help|help) usage ;;
  *) echo "dpings: unknown command '${1}'" >&2; usage; exit 1 ;;
esac
